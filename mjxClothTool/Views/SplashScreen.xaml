<Window x:Class="mjxClothTool.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mjxClothTool"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Height="512"
        Width="512"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="SplashAccent" Color="#5086B8" />
    </Window.Resources>
    <Border Background="#F20B0B0B" CornerRadius="20">
        <Grid UseLayoutRounding="True">
            <Canvas IsHitTestVisible="False">
                <Path Fill="{StaticResource SplashAccent}"
                      Data="M162,296 L240,158 262,164 262,212 293,158 315,164 315,257 291,257 291,208 261,262.5 238.5,256.5 238.5,208 182.5,307.5 Z
                            M326.5,204.5 L350,204.5 350,271 342,282.5 223,320 215.5,298 326.5,262.5 Z" />
            </Canvas>
            <ProgressBar x:Name="LoadingProgress"
                         Maximum="100"
                         Height="10"
                         Margin="34,0,34,34"
                         VerticalAlignment="Bottom"
                         Background="#203E5B"
                         Foreground="{StaticResource SplashAccent}"
                         AutomationProperties.Name="Startup progress">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>
        </Grid>
    </Border>
</Window>
