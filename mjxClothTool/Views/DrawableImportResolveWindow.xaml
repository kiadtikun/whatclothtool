<Window x:Class="mjxClothTool.Views.DrawableImportResolveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:mjxClothTool.Controls"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Resolve drawable import"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush50}"
        WindowStartupLocation="CenterOwner"
        Height="680"
        Width="780">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style x:Key="DrawableImportResolveRowBorder" TargetType="Border">
                <Setter Property="Margin" Value="4,2"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Background" Value="{DynamicResource Brush50}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush200}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsResolved}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush75}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush300}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush200}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush400}"/>
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush500}"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsPreviewed}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush800}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <Grid Grid.Row="0" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding HeaderText}" FontSize="16" Foreground="{DynamicResource Brush950}" FontWeight="Medium"/>
            <TextBlock Grid.Row="1"
                       Text="{Binding HelpText}"
                       FontSize="12"
                       Foreground="{DynamicResource Brush500}"
                       FontWeight="Light"
                       Margin="0,0,0,14"
                       TextWrapping="Wrap"/>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource Brush200}"
                    BorderThickness="1"
                    Background="{DynamicResource Brush100}"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="8,6">
                        <TextBlock Text="{Binding SelectionSummary}"
                                   Foreground="{DynamicResource Brush600}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox Content="Show resolved"
                                      IsChecked="{Binding ShowResolvedItems, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="4,0,10,0"
                                      Foreground="{DynamicResource Brush700}"/>
                            <Button Content="Select All"
                                    Width="80"
                                    Height="26"
                                    Margin="4,0,0,0"
                                    Click="SelectAll_Click"/>
                            <Button Content="Select None"
                                    Width="86"
                                    Height="26"
                                    Margin="4,0,0,0"
                                    Click="SelectNone_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="155"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VisibleItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DrawableImportResolveRowBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      AutomationProperties.Name="{Binding FileName, StringFormat=Check {0} for Apply}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            <Button Grid.Column="1"
                                                    AutomationProperties.Name="{Binding FileName, StringFormat=Preview {0}}"
                                                    ToolTip="{Binding FilePath}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand"
                                                    Click="PreviewItem_Click">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}"
                                                               Foreground="{DynamicResource Brush950}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding FilePath}"
                                                               Foreground="{DynamicResource Brush500}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="12,0,0,0">
                                                <TextBlock Text="{Binding GenderText}"
                                                           Visibility="{Binding DataContext.GenderTextVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Foreground="{DynamicResource Brush600}"
                                                           FontSize="11"
                                                           Margin="0,0,10,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasGender}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush900}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DrawableText}"
                                                           Visibility="{Binding DataContext.DrawableTextVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Foreground="{DynamicResource Brush600}"
                                                           FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDrawableType}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush900}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="3"
                                                    Content="Remove"
                                                    AutomationProperties.Name="{Binding FileName, StringFormat=Remove {0}}"
                                                    ToolTip="Remove from the import list"
                                                    Margin="10,0,0,0"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    Click="RemoveItem_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3">
                <Grid x:Name="GenderControls"
                      Margin="0,0,0,8"
                      Visibility="{Binding GenderControlsVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <c:ModernLabelComboBox
                        Grid.Column="0"
                        Label="Gender"
                        ItemsSource="{Binding GenderTypes}"
                        SelectedItem="{Binding SelectedGender}"
                        Margin="0,0,0,5"/>
                    <c:CustomButton
                        Grid.Column="2"
                        Label="Apply gender"
                        CornerRadius="5"
                        Height="40"
                        VerticalAlignment="Top"
                        Margin="0,5,0,5"
                        IsEnabled="{Binding IsGenderApplyEnabled}"
                        MyBtnClickEvent="ApplyGender_MyBtnClickEvent"/>
                </Grid>

                <Grid x:Name="DrawableControls"
                      Visibility="{Binding DrawableControlsVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <c:ModernLabelComboBox
                        Grid.Column="0"
                        Label="Asset type"
                        ItemsSource="{Binding AssetTypes}"
                        SelectedItem="{Binding SelectedAssetType}"
                        Margin="0,0,0,5"
                        IsUpdated="AssetType_IsUpdated"/>
                    <c:ModernLabelComboBox
                        Grid.Column="2"
                        Label="Drawable Component"
                        IsEnabled="{Binding IsAssetTypeSelected}"
                        ItemsSource="{Binding DrawableTypes}"
                        SelectedItem="{Binding SelectedDrawableType}"
                        Margin="0,0,0,5"/>
                    <c:CustomButton
                        Grid.Column="4"
                        Label="Apply properties"
                        CornerRadius="5"
                        Height="40"
                        VerticalAlignment="Top"
                        Margin="0,5,0,5"
                        IsEnabled="{Binding IsDrawableApplyEnabled}"
                        MyBtnClickEvent="ApplyDrawable_MyBtnClickEvent"/>
                </Grid>
            </StackPanel>

            <Border Grid.Row="4"
                    Margin="0,8,0,0"
                    Padding="10"
                    Background="{DynamicResource Brush100}"
                    BorderBrush="{DynamicResource Brush200}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock x:Name="PreviewTitle"
                               DockPanel.Dock="Top"
                               Text="3D Preview"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush950}"
                               Margin="0,0,0,6"
                               TextTrimming="CharacterEllipsis"/>
                    <Grid Background="{DynamicResource Brush75}"
                          ClipToBounds="True"
                          MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                          MouseMove="Preview_MouseMove"
                          MouseLeftButtonUp="Preview_MouseLeftButtonUp">
                        <Viewport3D x:Name="PreviewViewport"
                                    IsHitTestVisible="False"
                                    SizeChanged="PreviewViewport_SizeChanged">
                            <Viewport3D.Camera>
                                <OrthographicCamera x:Name="PreviewCamera"
                                                    Position="0,4,0.5"
                                                    LookDirection="0,-4,-0.5"
                                                    UpDirection="0,0,1"/>
                            </Viewport3D.Camera>
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <Model3DGroup>
                                        <AmbientLight Color="#A0A0A0"/>
                                        <DirectionalLight Color="#BFBFBF" Direction="-1,-2,-3"/>
                                        <DirectionalLight Color="#505050" Direction="1,2,-1"/>
                                    </Model3DGroup>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>
                            <ModelVisual3D x:Name="PreviewModel">
                                <ModelVisual3D.Transform>
                                    <RotateTransform3D>
                                        <RotateTransform3D.Rotation>
                                            <AxisAngleRotation3D x:Name="PreviewRotation" Axis="0,0,1" Angle="0"/>
                                        </RotateTransform3D.Rotation>
                                    </RotateTransform3D>
                                </ModelVisual3D.Transform>
                            </ModelVisual3D>
                        </Viewport3D>
                        <TextBlock x:Name="PreviewStatus"
                                   Text="Choose a file to preview."
                                   Foreground="{DynamicResource Brush600}"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="PreviewHint"
                                   Text="Drag to rotate"
                                   Foreground="{DynamicResource Brush600}"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="6"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="5">
            <c:CustomButton
                HorizontalAlignment="Left"
                CornerRadius="5"
                Width="150"
                Label="Cancel"
                MyBtnClickEvent="Cancel_MyBtnClickEvent"/>
            <c:CustomButton
                HorizontalAlignment="Right"
                CornerRadius="5"
                Width="150"
                Label="Continue"
                IsEnabled="{Binding IsSubmitEnabled}"
                MyBtnClickEvent="Select_MyBtnClickEvent"/>
        </Grid>
    </Grid>
</Window>
