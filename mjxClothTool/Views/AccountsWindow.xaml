<Window x:Class="mjxClothTool.Views.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:mjxClothTool.Controls"
        Background="{DynamicResource Brush50}"
        Title="Online accounts disabled" Height="230" Width="380"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Offline mode" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="Online account sign-in is disabled in this build."
                       Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <c:CustomButton Grid.Row="1" Label="Close" Height="42" CornerRadius="5" MyBtnClickEvent="CloseBtn_Click" />
    </Grid>
</Window>
