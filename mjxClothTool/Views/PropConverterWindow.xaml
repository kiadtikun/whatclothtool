<Window x:Class="mjxClothTool.Views.PropConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mjxClothTool · Prop Converter" Background="{DynamicResource Brush50}"
        Width="810" Height="560" MinWidth="710" MinHeight="500" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18" x:Name="Panel">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ReviewHint" Visibility="Collapsed" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <TextBlock x:Name="Status" Text="Choose a single accessory to convert." TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SkipReview" Visibility="Collapsed" Content="Skip file" Click="SkipReview_Click" Margin="0,0,8,0"/>
                <Button x:Name="StopReview" Visibility="Collapsed" Content="End review" Click="StopReview_Click" Margin="0,0,8,0"/>
                <Button Content="Preview conversion" Click="Preview_Click" Padding="12,5" Margin="0,0,8,0"/>
                <Button x:Name="Export" Content="Export prop…" Click="Export_Click" IsEnabled="False" Padding="12,5"/>
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                <StackPanel>
                    <StackPanel x:Name="ProjectPanel" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock x:Name="ProjectCount" FontWeight="SemiBold"/>
                        <TextBlock Text="Ctrl+click or Shift+click to select multiple. Ctrl+A selects all." TextWrapping="Wrap"/><ListBox x:Name="ProjectFiles" Margin="0,4,0,0" MaxHeight="115" SelectionMode="Extended"
                                 SelectionChanged="ProjectFileChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    <TextBlock Text="Preview character" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,4,0,2">
                        <Button DockPanel.Dock="Right" Content="GTA folder…" Click="GameFolder_Click" Margin="6,0,0,0"/>
                        <ComboBox x:Name="Character" SelectedIndex="0" SelectionChanged="CharacterChanged">
                            <ComboBoxItem Content="Freemode male" Tag="mp_m_freemode_01"/>
                            <ComboBoxItem Content="Freemode female" Tag="mp_f_freemode_01"/>
                        </ComboBox>
                    </DockPanel>
                    <TextBlock x:Name="CharacterStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="SourceLabel" Text="Source accessory" FontWeight="SemiBold"/>
                    <Button x:Name="Source" Content="Choose YDD or YDR…" Click="Source_Click" Margin="0,4,0,8"/>
                    <TextBlock Text="Override character skeleton (optional YFT)"/>
                    <Button x:Name="Rig" Content="Auto (local GTA V) · choose override…" Click="Rig_Click" Margin="0,4,0,8"/>
                    <TextBlock Text="External texture variations"/>
                    <Button x:Name="Textures" Content="Choose YTD files…" Click="Textures_Click" Margin="0,4,0,10"/>
                    <CheckBox x:Name="WholeGlasses" Content="Use all pieces as glasses" IsChecked="True" Click="InputChanged" Margin="0,2,0,4"/>
                    <CheckBox x:Name="AutoPieces" Content="Auto-select pieces near target slot" IsChecked="True" Click="InputChanged" Margin="0,2,0,4"/>
                    <Button x:Name="ChoosePieces" Content="Choose mesh pieces…" Click="ChoosePieces_Click" IsEnabled="False"/>
                    <TextBlock x:Name="PieceHint" Text="Whole drawable" TextWrapping="Wrap" Margin="0,2,0,4"/>
                    <ListBox x:Name="PieceList" Visibility="Collapsed" MaxHeight="112" SelectionMode="Multiple" SelectionChanged="PieceSelectionChanged"/>
                    <TextBlock Text="Target slot"/>
                    <ComboBox x:Name="Slot" SelectedIndex="0" SelectionChanged="InputChanged" Margin="0,4,0,8">
                        <ComboBoxItem Content="Glasses · p_eyes" Tag="p_eyes"/>
                        <ComboBoxItem Content="Left wrist · p_lwrist" Tag="p_lwrist"/>
                        <ComboBoxItem Content="Right wrist · p_rwrist" Tag="p_rwrist"/>
                    </ComboBox>
                    <UniformGrid Columns="2" Margin="0,2,0,8">
                        <StackPanel><TextBlock Text="Drawable number"/><TextBox x:Name="Number" Text="0" TextChanged="InputChanged"/></StackPanel>
                        <StackPanel Margin="8,0,0,0"><TextBlock Text="Scale"/><TextBox x:Name="ScaleBox" Text="1" TextChanged="InputChanged"/></StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Offset X / Y / Z (metres)"/>
                    <UniformGrid Columns="3" Margin="0,4,0,8">
                        <TextBox x:Name="X" Text="0" TextChanged="InputChanged"/><TextBox x:Name="Y" Text="0" TextChanged="InputChanged"/><TextBox x:Name="Z" Text="0" TextChanged="InputChanged"/>
                    </UniformGrid>
                    <TextBlock Text="Rotation X / Y / Z (degrees, applied in order)"/>
                    <UniformGrid Columns="3" Margin="0,4,0,0">
                        <TextBox x:Name="Rx" Text="0" TextChanged="InputChanged"/><TextBox x:Name="Ry" Text="0" TextChanged="InputChanged"/><TextBox x:Name="Rz" Text="0" TextChanged="InputChanged"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="1" Background="{DynamicResource Brush100}" MouseWheel="ZoomPreview">
                <Viewport3D x:Name="Viewport" ClipToBounds="True">
                    <Viewport3D.Camera><OrthographicCamera x:Name="Camera" Position="0,-2,0.5" LookDirection="0,2,-0.5" UpDirection="0,0,1" Width="0.5"/></Viewport3D.Camera>
                    <ModelVisual3D><ModelVisual3D.Content>
                        <Model3DGroup><AmbientLight Color="#AAA"/><DirectionalLight Color="White" Direction="-1,2,-3"/></Model3DGroup>
                    </ModelVisual3D.Content></ModelVisual3D>
                    <ModelVisual3D x:Name="Body"/>
                    <ModelVisual3D x:Name="Mesh"/>
                </Viewport3D>
                <Viewport3D x:Name="RevealView" Camera="{Binding Camera, ElementName=Viewport}" IsHitTestVisible="False" ClipToBounds="True">
                    <ModelVisual3D><ModelVisual3D.Content><Model3DGroup>
                        <AmbientLight Color="#999999"/><DirectionalLight Color="White" Direction="-1,2,-3"/>
                    </Model3DGroup></ModelVisual3D.Content></ModelVisual3D>
                    <ModelVisual3D x:Name="Highlight"/>
                </Viewport3D>
                <Canvas x:Name="Axes" ClipToBounds="True" SizeChanged="AxesSizeChanged" MouseLeftButtonDown="AxisDown"
                        MouseMove="AxisMove" MouseLeftButtonUp="AxisUp" LostMouseCapture="AxisLostCapture"/>
                <WrapPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6">
                    <ToggleButton x:Name="Reveal" Content="Reveal accessory" IsChecked="True" Click="Reveal_Click" Padding="5,2"/>
                    <Button Content="Fit accessory" Click="FitAccessory_Click" Margin="4,0" Padding="5,2"/>
                    <Button Content="Fit character" Click="FitCharacter_Click" Padding="5,2"/>
                </WrapPanel>
                <StackPanel VerticalAlignment="Bottom" Margin="10">
                    <TextBlock Text="Rotate view · scroll to zoom"/>
                    <Slider x:Name="Angle" Minimum="-180" Maximum="180" Value="0" ValueChanged="AngleChanged"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
